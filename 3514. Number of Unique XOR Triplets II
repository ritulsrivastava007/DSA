class Solution {
    public int uniqueXorTriplets(int[] nums) {
        final int MAX = 2048;

        boolean[] one = new boolean[MAX];
        boolean[] two = new boolean[MAX];
        boolean[] three = new boolean[MAX];
        for (int x : nums) {
            one[x] = true;
        }

        for (int a = 0; a < MAX; a++) {
            if (!one[a]) continue;
            for (int x : nums) {
                two[a ^ x] = true;
            }
        }

        for (int b = 0; b < MAX; b++) {
            if (!two[b]) continue;
            for (int x : nums) {
                three[b ^ x] = true;
            }
        }

        int ans = 0;
        for (boolean v : three) {
            if (v) ans++;
        }

        return ans;
    }
}
